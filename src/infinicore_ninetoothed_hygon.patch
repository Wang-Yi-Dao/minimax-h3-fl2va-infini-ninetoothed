diff --git a/src/infiniop/ops/rms_norm/ninetoothed/build.py b/src/infiniop/ops/rms_norm/ninetoothed/build.py
new file mode 100644
index 00000000..c808563e
--- /dev/null
+++ b/src/infiniop/ops/rms_norm/ninetoothed/build.py
@@ -0,0 +1,36 @@
+import ninetoothed
+
+import infiniop.ninetoothed.build
+
+from . import rms_norm
+
+_DTYPES = (ninetoothed.float16, ninetoothed.bfloat16, ninetoothed.float32)
+
+# Keep in sync with pick_block_size() in rms_norm.h: one block per row makes
+# NineToothed's two-pass application read the row from cache instead of HBM.
+_BLOCK_SIZES = (256, 1024, 8192)
+
+
+def build():
+    configs = tuple(
+        {
+            "ndim": ndim,
+            "num_normalized_dims": 1,
+            "input_dtype": input_dtype,
+            "weight_dtype": weight_dtype,
+            "output_dtype": input_dtype,
+            "block_size": block_size,
+        }
+        for ndim in range(2, 5)
+        for input_dtype in _DTYPES
+        for weight_dtype in _DTYPES
+        for block_size in _BLOCK_SIZES
+    )
+
+    infiniop.ninetoothed.build.build(
+        rms_norm.premake,
+        configs,
+        caller="cuda",
+        op_name="rms_norm",
+        output_dir=infiniop.ninetoothed.build.BUILD_DIRECTORY_PATH,
+    )
diff --git a/src/infiniop/ops/rms_norm/ninetoothed/rms_norm.h b/src/infiniop/ops/rms_norm/ninetoothed/rms_norm.h
new file mode 100644
index 00000000..deaea6ab
--- /dev/null
+++ b/src/infiniop/ops/rms_norm/ninetoothed/rms_norm.h
@@ -0,0 +1,163 @@
+#ifndef RMS_NORM_NINETOOTHED_H
+#define RMS_NORM_NINETOOTHED_H
+
+#include <cstdint>
+#include <vector>
+
+#include "../../../handle.h"
+#include "../../../../../build/ninetoothed/rms_norm.h"
+#include "../../../ninetoothed/utils.h"
+#include "../../../operator.h"
+#include "../../../tensor.h"
+
+
+namespace op::rms_norm::ninetoothed {
+
+// NineToothed's RMSNorm application walks the normalized row in tiles of
+// `block_size`, once to accumulate the sum of squares and once to write the
+// result.  Every extra tile therefore costs another full read of the row from
+// global memory.  The generated kernels only exist for the block sizes listed
+// in build.py, so pick the smallest compiled block that still covers a whole
+// row (one tile -> the second read hits cache instead of HBM).  Rows longer
+// than the largest compiled block keep tiling.
+inline int pick_block_size(std::int64_t num_normalized_elements) {
+    if (num_normalized_elements <= 256) {
+        return 256;
+    }
+    if (num_normalized_elements <= 1024) {
+        return 1024;
+    }
+    return 8192;
+}
+
+class Descriptor final : public InfiniopDescriptor {
+public:
+    Descriptor(
+        infiniopHandle_t handle,
+        infiniopTensorDescriptor_t y_desc,
+        infiniopTensorDescriptor_t x_desc,
+        infiniopTensorDescriptor_t w_desc,
+        float epsilon) : InfiniopDescriptor{handle->device, handle->device_id},
+                         y_shape_{y_desc->shape()},
+                         y_strides_{y_desc->strides()},
+                         x_shape_{x_desc->shape()},
+                         x_strides_{x_desc->strides()},
+                         dtype_{y_desc->dtype()},
+                         weight_dtype_{w_desc->dtype()},
+                         epsilon_{epsilon},
+                         num_normalized_elements_{static_cast<std::int64_t>(y_desc->shape().back())},
+                         block_size_{pick_block_size(num_normalized_elements_)} {
+        // NineToothed RMSNorm broadcasts the weight over every leading
+        // dimension, so it is described with the output shape and zero strides.
+        weight_shape_ = y_shape_;
+        weight_strides_.assign(y_shape_.size(), 0);
+        weight_strides_.back() = w_desc->strides().empty() ? 1 : w_desc->strides().back();
+    }
+
+    ~Descriptor() = default;
+
+    size_t workspaceSize() const {
+        return 0;
+    }
+
+    static infiniStatus_t create(
+        infiniopHandle_t handle,
+        Descriptor **desc_ptr,
+        infiniopTensorDescriptor_t y_desc,
+        infiniopTensorDescriptor_t x_desc,
+        infiniopTensorDescriptor_t w_desc,
+        float epsilon) {
+        auto dtype = y_desc->dtype();
+        auto weight_dtype = w_desc->dtype();
+
+        if (dtype != x_desc->dtype()) {
+            return INFINI_STATUS_BAD_TENSOR_DTYPE;
+        }
+
+        if (dtype != INFINI_DTYPE_F16 && dtype != INFINI_DTYPE_BF16 && dtype != INFINI_DTYPE_F32) {
+            return INFINI_STATUS_BAD_TENSOR_DTYPE;
+        }
+
+        if (weight_dtype != INFINI_DTYPE_F16 && weight_dtype != INFINI_DTYPE_BF16 && weight_dtype != INFINI_DTYPE_F32) {
+            return INFINI_STATUS_BAD_TENSOR_DTYPE;
+        }
+
+        if (y_desc->shape() != x_desc->shape()) {
+            return INFINI_STATUS_BAD_TENSOR_SHAPE;
+        }
+
+        auto ndim = y_desc->shape().size();
+        if (ndim < 2 || ndim > 4) {
+            return INFINI_STATUS_BAD_TENSOR_SHAPE;
+        }
+
+        if (w_desc->shape().size() != 1 || w_desc->shape().back() != y_desc->shape().back()) {
+            return INFINI_STATUS_BAD_TENSOR_SHAPE;
+        }
+
+        *desc_ptr = new Descriptor(handle, y_desc, x_desc, w_desc, epsilon);
+        return INFINI_STATUS_SUCCESS;
+    }
+
+    infiniStatus_t calculate(
+        void *workspace,
+        size_t workspace_size,
+        void *y,
+        const void *x,
+        const void *w,
+        void *stream) const {
+        if (workspace_size < workspaceSize()) {
+            return INFINI_STATUS_INSUFFICIENT_WORKSPACE;
+        }
+
+        auto input_nt{::ninetoothed::Tensor<>{x, x_shape_, x_strides_}};
+        auto weight_nt{::ninetoothed::Tensor<>{w, weight_shape_, weight_strides_}};
+        auto output_nt{::ninetoothed::Tensor<>{y, y_shape_, y_strides_}};
+
+        ::ninetoothed::Tensor<double> eps_nt{epsilon_};
+        ::ninetoothed::Tensor<std::int64_t> num_normalized_elements_nt{num_normalized_elements_};
+
+        auto dtype = static_cast<int>(dtype_);
+        auto weight_dtype = static_cast<int>(weight_dtype_);
+
+        if (launch_rms_norm(stream,
+                            input_nt,
+                            weight_nt,
+                            eps_nt,
+                            output_nt,
+                            num_normalized_elements_nt,
+                            static_cast<int>(y_shape_.size()),
+                            1,
+                            dtype,
+                            weight_dtype,
+                            dtype,
+                            block_size_)) {
+            return INFINI_STATUS_NOT_IMPLEMENTED;
+        }
+
+        return INFINI_STATUS_SUCCESS;
+    }
+
+private:
+    using Size = ::ninetoothed::Tensor<>::Size;
+    using Stride = ::ninetoothed::Tensor<>::Stride;
+
+    std::vector<Size> y_shape_;
+    std::vector<Stride> y_strides_;
+
+    std::vector<Size> x_shape_;
+    std::vector<Stride> x_strides_;
+
+    std::vector<Size> weight_shape_;
+    std::vector<Stride> weight_strides_;
+
+    infiniDtype_t dtype_;
+    infiniDtype_t weight_dtype_;
+    float epsilon_;
+    std::int64_t num_normalized_elements_;
+    int block_size_;
+};
+
+} // namespace op::rms_norm::ninetoothed
+
+#endif // RMS_NORM_NINETOOTHED_H
