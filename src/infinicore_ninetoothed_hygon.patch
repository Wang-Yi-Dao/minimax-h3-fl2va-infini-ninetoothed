+import ninetoothed
+
+import infiniop.ninetoothed.build
+
+from . import timestep_embedding
+
+_DTYPES = (ninetoothed.float16, ninetoothed.bfloat16, ninetoothed.float32)
+
+_EMBEDDING_DIMS = (16, 256)
+
+
+def build():
+    configs = tuple(
+        {
+            "embedding_dim": embedding_dim,
+            "input_dtype": input_dtype,
+        }
+        for embedding_dim in _EMBEDDING_DIMS
+        for input_dtype in _DTYPES
+    )
+
+    infiniop.ninetoothed.build.build(
+        timestep_embedding.premake,
+        configs,
+        caller="cuda",
+        op_name="timestep_embedding",
+        output_dir=infiniop.ninetoothed.build.BUILD_DIRECTORY_PATH,
+    )
diff --git a/src/infiniop/ops/timestep_embedding/ninetoothed/timestep_embedding.h b/src/infiniop/ops/timestep_embedding/ninetoothed/timestep_embedding.h
new file mode 100644
index 00000000..5602332a
--- /dev/null
+++ b/src/infiniop/ops/timestep_embedding/ninetoothed/timestep_embedding.h
@@ -0,0 +1,128 @@
+#ifndef TIMESTEP_EMBEDDING_NINETOOTHED_H
+#define TIMESTEP_EMBEDDING_NINETOOTHED_H
+
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+#include "../../../handle.h"
+#include "../../../../../build/ninetoothed/timestep_embedding.h"
+#include "../../../ninetoothed/utils.h"
+#include "../../../operator.h"
+#include "../../../tensor.h"
+
+
+namespace op::timestep_embedding::ninetoothed {
+
+class Descriptor final : public InfiniopDescriptor {
+public:
+    Descriptor(
+        infiniopHandle_t handle,
+        size_t num_timesteps,
+        size_t embedding_dim,
+        infiniDtype_t input_dtype) : InfiniopDescriptor{handle->device, handle->device_id},
+                                     num_timesteps_{num_timesteps},
+                                     embedding_dim_{embedding_dim},
+                                     input_dtype_{input_dtype} {}
+
+    ~Descriptor() = default;
+
+    static infiniStatus_t create(
+        infiniopHandle_t handle,
+        Descriptor **desc_ptr,
+        infiniopTensorDescriptor_t output_desc,
+        infiniopTensorDescriptor_t timestep_desc) {
+        if (timestep_desc->shape().size() != 1) {
+            return INFINI_STATUS_BAD_TENSOR_SHAPE;
+        }
+
+        if (output_desc->shape().size() != 2) {
+            return INFINI_STATUS_BAD_TENSOR_SHAPE;
+        }
+
+        if (output_desc->shape()[0] != timestep_desc->shape()[0]
+            || output_desc->shape()[1] == 0
+            || output_desc->shape()[1] % 2 != 0) {
+            return INFINI_STATUS_BAD_TENSOR_SHAPE;
+        }
+
+        if (output_desc->dtype() != INFINI_DTYPE_F32) {
+            return INFINI_STATUS_BAD_TENSOR_DTYPE;
+        }
+
+        CHECK_DTYPE(timestep_desc->dtype(),
+                    INFINI_DTYPE_F16, INFINI_DTYPE_BF16, INFINI_DTYPE_F32);
+
+        if (!output_desc->isContiguous() || !timestep_desc->isContiguous()) {
+            return INFINI_STATUS_BAD_TENSOR_STRIDES;
+        }
+
+        auto embedding_dim = output_desc->shape()[1];
+
+        if (embedding_dim != 16 && embedding_dim != 256) {
+            return INFINI_STATUS_NOT_IMPLEMENTED;
+        }
+
+        *desc_ptr = new Descriptor(
+            handle,
+            timestep_desc->shape()[0],
+            embedding_dim,
+            timestep_desc->dtype());
+
+        return INFINI_STATUS_SUCCESS;
+    }
+
+    infiniStatus_t calculate(
+        void *output,
+        const void *timestep,
+        float max_period,
+        void *stream) const {
+        if (max_period <= 0.0f) {
+            return INFINI_STATUS_BAD_PARAM;
+        }
+
+        if (num_timesteps_ == 0) {
+            return INFINI_STATUS_SUCCESS;
+        }
+
+        std::vector<::ninetoothed::Tensor<>::Size> output_shape{
+            static_cast<::ninetoothed::Tensor<>::Size>(num_timesteps_),
+            static_cast<::ninetoothed::Tensor<>::Size>(embedding_dim_)};
+
+        std::vector<::ninetoothed::Tensor<>::Stride> output_strides{
+            static_cast<::ninetoothed::Tensor<>::Stride>(embedding_dim_), 1};
+
+        // The timestep is shared by every element of a row, so it is described
+        // with the output shape and a zero stride along the embedding dimension.
+        std::vector<::ninetoothed::Tensor<>::Stride> timestep_strides{1, 0};
+
+        auto output_nt{::ninetoothed::Tensor<>{output, output_shape, output_strides}};
+        auto timestep_nt{::ninetoothed::Tensor<>{timestep, output_shape, timestep_strides}};
+
+        // The generated launcher reads this scalar as a double (the AOT trace
+        // types the Python float argument as fp64), so the holder must be double
+        // as well; a float holder made the kernel read 4 bytes of value plus 4
+        // bytes of padding and every output came out wrong.
+        ::ninetoothed::Tensor<double> log_max_period_nt{std::log(static_cast<double>(max_period))};
+
+        if (launch_timestep_embedding(stream,
+                                      output_nt,
+                                      timestep_nt,
+                                      log_max_period_nt,
+                                      static_cast<int>(embedding_dim_),
+                                      static_cast<int>(input_dtype_))) {
+            return INFINI_STATUS_NOT_IMPLEMENTED;
+        }
+
+        return INFINI_STATUS_SUCCESS;
+    }
+
+private:
+    size_t num_timesteps_;
+    size_t embedding_dim_;
+    infiniDtype_t input_dtype_;
+};
+
+} // namespace op::timestep_embedding::ninetoothed
+
+#endif // TIMESTEP_EMBEDDING_NINETOOTHED_H
diff --git a/src/infiniop/ops/timestep_embedding/ninetoothed/timestep_embedding.py b/src/infiniop/ops/timestep_embedding/ninetoothed/timestep_embedding.py
new file mode 100644
index 00000000..d09b72a9
--- /dev/null
+++ b/src/infiniop/ops/timestep_embedding/ninetoothed/timestep_embedding.py
@@ -0,0 +1,61 @@
+import ninetoothed
+import ninetoothed.language as ntl
+from ninetoothed import Tensor
+
+
+# 说明：九齿的 AOT 通过 re-parse 函数源码来 trace kernel，闭包变量在生成的模块里不可见
+# （NameError: 'embedding_dim' is not defined）。因此这里为每个 embedding_dim 写一个
+# 常量已内联的 application，而不是用闭包捕获。
+def _application_16(output, timestep, log_max_period):
+    log_mp = ntl.cast(log_max_period, ntl.float32)
+
+    for i in range(1):
+        for j in range(16):
+            angle = ntl.cast(timestep[i, j], ntl.float32) * ntl.exp(
+                -log_mp * (j % 8) / 8
+            )
+
+            if j < 8:
+                output[i, j] = ntl.cos(angle)
+            else:
+                output[i, j] = ntl.sin(angle)
+
+
+def _application_256(output, timestep, log_max_period):
+    log_mp = ntl.cast(log_max_period, ntl.float32)
+
+    for i in range(1):
+        for j in range(256):
+            angle = ntl.cast(timestep[i, j], ntl.float32) * ntl.exp(
+                -log_mp * (j % 128) / 128
+            )
+
+            if j < 128:
+                output[i, j] = ntl.cos(angle)
+            else:
+                output[i, j] = ntl.sin(angle)
+
+
+_APPLICATIONS = {
+    16: _application_16,
+    256: _application_256,
+}
+
+
+def premake(embedding_dim, input_dtype=None):
+    application = _APPLICATIONS[embedding_dim]
+
+    def arrangement(output, timestep, log_max_period):
+        return (
+            output.tile((1, embedding_dim)),
+            timestep.tile((1, embedding_dim)),
+            log_max_period,
+        )
+
+    tensors = (
+        Tensor(2, dtype=ninetoothed.float32),
+        Tensor(2, dtype=input_dtype),
+        Tensor(0, dtype=ninetoothed.float32),
+    )
+
+    return arrangement, application, tensors
